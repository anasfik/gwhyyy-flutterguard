{
  "name": "FlutterGuard",
  "url": "https://flutterguard.dev/",
  "description": "Flutter APK inspection on Android and in CI: the app reads a release on the device, and a source-built CLI runs the same JVM engine to write redacted JSON and SARIF. No account, MIT licensed.",
  "contact": "work@gwhyyy.com",
  "license": "https://github.com/anasfik/FlutterGuard/blob/main/LICENSE",
  "application": {
    "category": "SecurityApplication",
    "operatingSystems": ["Android 8.0+"],
    "install": {
      "googlePlay": "https://play.google.com/store/apps/details?id=com.flutterguard.app",
      "apk": "https://github.com/anasfik/FlutterGuard/releases/latest"
    }
  },
  "cli": {
    "source": "https://github.com/anasfik/FlutterGuard/tree/main/cli",
    "build": "./gradlew :cli:installDist",
    "runtime": "JVM, JDK 17 or newer",
    "distribution": "Source build only: no published CLI distribution or Maven/JitPack package is established.",
    "outputs": ["Redacted JSON, schema flutterguard/report/2", "SARIF 2.1.0"]
  },
  "engine": {
    "source": "https://github.com/anasfik/FlutterGuard/tree/main/engine",
    "distribution": "Shared repository module, not a separately published SDK."
  },
