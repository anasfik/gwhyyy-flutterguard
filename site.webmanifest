{
  "name": "FlutterGuard",
  "short_name": "FlutterGuard",
  "description": "On-device Flutter APK inspection for Android: libraries, endpoints and exposed strings. No uploads, no account. MIT.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6f5",
  "theme_color": "#f4f6f5",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
