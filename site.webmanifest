{
  "name": "FlutterGuard",
  "short_name": "FlutterGuard",
  "description": "Security audit any released Flutter app on Android: read libraries, endpoints and exposed strings, then save the evidence on your device. MIT.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f5ef",
  "theme_color": "#f3f5ef",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
